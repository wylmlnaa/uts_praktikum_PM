# ============================================
# BLOCKCHAIN (Hardhat)
# ============================================

# Sepolia RPC (Alchemy / Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-key>

# Deployer private key (DO NOT COMMIT real key to repo)
DEPLOYER_PRIVATE_KEY=0x<your-64-char-private-key-without-0x-prefix>

# Contract address (isi setelah deploy)
TASK_LEDGER_CONTRACT_ADDRESS=

# Etherscan untuk verifikasi kontrak (opsional)
ETHERSCAN_API_KEY=

# Verifier address (alamat yang boleh verifikasi task)
VERIFIER_ADDRESS=
